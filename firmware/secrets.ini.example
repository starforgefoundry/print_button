; Copy to secrets.ini. Every value is optional and only used until it is changed in the web UI.
[secrets]
build_flags =
    '-DDEFAULT_WIFI_SSID="my-network"'
    '-DDEFAULT_WIFI_PASSWORD="my-password"'
    '-DDEFAULT_BAMBUDDY_URL="http://bambuddy.local:8000"'
    '-DDEFAULT_BAMBUDDY_API_KEY="bb_xxx"'
